# FILE: Dockerfile.backend
# ROLE: Builds the FastAPI backend service for production deployment on Render.

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for psycopg2 and Pillow
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

EXPOSE 8000

CMD alembic upgrade head && python scripts/seed_cities.py && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2CMD alembic upgrade head && PYTHONPATH=/app python scripts/seed_cities.py && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2