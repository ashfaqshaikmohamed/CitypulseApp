# FILE: .env.example
# ROLE: Environment variable configuration template for local development and production services.

# --- AI / VISION ---
# RECOMMENDATION: Use Gemini 1.5 Flash (free, 1500 req/day)
# Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_api_key_here
VISION_MOCK=true   # KEEP THIS TRUE during development — saves your free quota

# --- DATABASE ---
# Local Docker (development) — no account needed
DATABASE_URL=postgresql+asyncpg://citypulse:citypulse@localhost:5432/citypulse
# For production, use Neon.tech (free PostgreSQL with PostGIS, 0.5GB free)
# Sign up: neon.tech — no credit card needed
# PROD_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/citypulse

# --- CACHE / QUEUE ---
# Local Docker (development) — no account needed
REDIS_URL=redis://localhost:6379/0
# For production, use Upstash Redis (free tier: 10,000 req/day)
# Sign up: upstash.com — no credit card needed
# PROD_REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# --- FILE STORAGE (replaces AWS S3) ---
# RECOMMENDATION: Cloudflare R2 — 10GB free, no egress fees, S3-compatible
# Get from: cloudflare.com → R2 → Create bucket → API tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-bucket-public-url.r2.dev

# --- MAPS ---
# Geocoding only (reverse geocode photo GPS → address)
# RECOMMENDATION: Mapbox free tier covers 200k requests/month — plenty
# Get from: mapbox.com → Account → Tokens
MAPBOX_TOKEN=your_mapbox_token_here
# Map TILES use OpenStreetMap via MapLibre GL JS — completely free, no token needed

# --- EMAIL (replaces SendGrid) ---
# RECOMMENDATION: Resend — 3,000 emails/month free, great API
# Get from: resend.com → API Keys
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
# During development, use: onboarding@resend.dev as FROM (works without a domain)
DEV_EMAIL_FROM=onboarding@resend.dev

# --- CITY 311 APIs ---
# NYC Open Data (free, just need app token to avoid rate limits)
# Get from: data.cityofnewyork.us → Sign In → App Tokens
NYC_311_APP_TOKEN=your_nyc_311_app_token_here
# Chicago and Boston: completely open, no token required (add later)
# CHICAGO_311_TOKEN=not_needed_yet
# BOSTON_311_TOKEN=not_needed_yet

# --- APP ---
SECRET_KEY=generate_a_random_64char_string_here  # run: openssl rand -hex 32
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
